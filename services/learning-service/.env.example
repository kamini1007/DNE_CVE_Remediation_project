PORT=3002

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cve_db
DB_USER=postgres
DB_PASSWORD=postgres

# Cron expression for the recurring calibration report job (node-cron syntax)
CALIBRATION_CRON=0 0 3 * * *
# Below this many data points, a stat is computed but never turned into a
# recommendation - avoids acting on noise.
CALIBRATION_MIN_SAMPLE_SIZE=5
# Average rating (out of 5) below which a risk level or prompt version gets flagged.
CALIBRATION_RATING_THRESHOLD=3.0
# SLA-met fraction below which a risk level's remediation performance gets flagged.
CALIBRATION_SLA_THRESHOLD=0.7
