# --- Server ---
PORT=3000

# --- Database (populated via ExternalSecret -> k8s Secret in-cluster) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cve_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- AWS Bedrock ---
AWS_REGION=us-east-1
# Primary model tried first, then each fallback in order (e.g. on throttling).
BEDROCK_PRIMARY_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_IDS=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1500
# Optional - point at LocalStack or the local mock-bedrock service instead of
# real AWS Bedrock (see infra/localstack/README.md). Leave unset in production.
BEDROCK_ENDPOINT_URL=http://localhost:4010

# --- Scheduling / batching ---
# Cron expression for the recurring analysis batch job (node-cron syntax)
ANALYSIS_CRON=*/15 * * * *
ANALYSIS_BATCH_SIZE=25
ANALYSIS_CONCURRENCY=3
