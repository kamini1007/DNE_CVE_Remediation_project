# --- Jira Configuration ---
# Leave these blank/unset to run in DRY-RUN mode (playbooks generated, no real tickets)
# To enable Jira integration, set all four variables:
# - Get API token from: https://id.atlassian.com/manage/api-tokens
# - API token must have "Manage Jira" and "Create issues" permissions
JIRA_BASE_URL=https://ashish001007.atlassian.net
JIRA_EMAIL=kaminirai07@gmail.com
JIRA_API_TOKEN=ATATT3xFfGF0GSiU-kDwvksAthsxU5-BEePCTsksDdRkdZLhwx7JrQOOGDTboTJxLfZD_VO3xaxe-4ME4-fJJPzs8UP26Bugm-8yWhyq_LSjiuOcJaS-jgIM6D780cP8soKgJxDNhlV7UHqxEW-viCFffEaNHIEj4rECyjsjNo9w1QFcxmox_vM=D7DA8EA7
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Task

# --- Remediation Batching ---
# Cron expression for recurring remediation batch job (node-cron syntax)
# Default: every 2 hours
REMEDIATION_CRON=0 0 */2 * * *
REMEDIATION_BATCH_SIZE=50
# Only CVEs at or above this risk level get remediation action
# Options: LOW, MEDIUM, HIGH, CRITICAL
REMEDIATION_MIN_RISK_LEVEL=HIGH

# --- Logging ---
LOG_LEVEL=INFO
