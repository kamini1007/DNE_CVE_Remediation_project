# --- Server ---
PORT=3001

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cve_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Jira (optional - omit any of these to run in dry-run mode: playbooks
# are still generated and stored, just no real ticket gets created) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@your-org.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task

# --- Remediation batching ---
# Cron expression for the recurring remediation batch job (node-cron syntax)
REMEDIATION_CRON=0 0 */2 * * *
REMEDIATION_BATCH_SIZE=50
# Only CVEs at or above this risk level get a remediation action/ticket.
REMEDIATION_MIN_RISK_LEVEL=HIGH
