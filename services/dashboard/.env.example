# Backend service URLs. Vite inlines these at BUILD time (not runtime), so
# changing them requires rebuilding the image - see Dockerfile build args.
VITE_INGESTION_API_URL=http://localhost:8080
VITE_AI_ANALYSIS_API_URL=http://localhost:3000
VITE_RISK_ENGINE_API_URL=http://localhost:8083
VITE_REMEDIATION_API_URL=http://localhost:3001
VITE_LEARNING_API_URL=http://localhost:3002
